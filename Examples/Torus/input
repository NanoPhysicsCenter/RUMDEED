&INPUT
  V_S = 160000.0d0,                   ! Voltage over the gap in volts, should match the voltage of the Torus_mesh_data.txt file
  BOX_DIM = 0.0d0, 0.0d0, 4.0d5,      ! Simulation box in nano-meters, last number is the gap spacing and must match the maximum z in the mesh data. Others ignored
  TIME_STEP = 1.00d-4,                ! Size of the time step in pico-seconds
  STEPS = 1000,                       ! Number of time steps to do in the simulation
  EMISSION_MODE = 12,                 ! 12 = Field emission from a torus (looped CNT), field interpolated from mesh data files
  NREMIT = 1,                         ! Number of emitters in the system
  IMAGE_CHARGE = .True.,              ! True means use image charge effects
  N_IC_MAX = 1,                       ! Image charge partners: 0 = 1 partner, 1 = 5 partners
  COLLISION_MODE = 0,                 ! 0 = Off, 1 = Continuous ionization, 2 = 1 + discrete recombination, 3 = Discrete ionization, 4 = 3 + discrete recombination
  T_temp = 293.15d0,                  ! Temperature [K] of the ion gas
  P_abs = 1.0d0,                      ! Pressure of the ion gas as a fraction of NTP pressure
  write_position_file = .True.,       ! Write particle positions to out/position.dt

  EMITTERS_DIM(1:3, 1) = 500.0d0, 500.0d0, 0.0d0,   ! Ignored for the torus, geometry comes from the mesh data files
  EMITTERS_POS(1:3, 1) = -250.0d0, -250.0d0, 0.0d0, ! Ignored for the torus
  EMITTERS_TYPE(1) = 2,                             ! Ignored for the torus
  EMITTERS_DELAY(1) = 0,                            ! In what time step the emitter should be turned on
/
