&INPUT
  V_S = 2.0d3,                        ! Voltage over the gap in volts
  BOX_DIM = 0.0d0, 0.0d0, 1000.0d0,   ! Simulation box in nano-meters, last number is the gap spacing. Others ignored
  TIME_STEP = 1.00d-4,                ! Size of the time step in pico-seconds
  STEPS = 2000,                       ! Number of time steps to do in the simulation
  EMISSION_MODE = 9,                  ! 9 = General thermal-field (GTF) emission, planar geometry
  NREMIT = 1,                         ! Number of emitters in the system
  IMAGE_CHARGE = .True.,              ! True means use image charge effects
  N_IC_MAX = 1,                       ! Image charge partners: 0 = 1 partner, 1 = 5 partners
  COLLISION_MODE = 0,                 ! 0 = Off, 1 = Continuous ionization, 2 = 1 + discrete recombination, 3 = Discrete ionization, 4 = 3 + discrete recombination
  T_temp = 1000.0d0,                  ! Temperature [K] of the cathode
  P_abs = 1.0d0,                      ! Pressure of the ion gas as a fraction of NTP pressure

  EMITTERS_DIM(1:3, 1) = 100.0d0, 100.0d0, 0.0d0, ! Dimensions of the emitter x and y in nano-meters, z is ignored
  EMITTERS_POS(1:3, 1) = -50.0d0, -50.0d0, 0.0d0, ! x and y position of the emitter in nano-meters, z is ignored
  EMITTERS_TYPE(1) = 2,                           ! Type of emitter: 1 = circle, 2 = rectangle, 3 = rectangle with spots
  EMITTERS_DELAY(1) = 0,                          ! In what time step the emitter should be turned on
/
